# Variables raíz del monorepo. La app web usa apps/web/.env.local
# Copia apps/web/.env.example a apps/web/.env.local y rellena los valores.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel AI Gateway (proveedor LLM para Aria)
AI_GATEWAY_API_KEY=
# Opcional: base URL custom si usas un gateway distinto
# AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1/openai
# Modelo concreto a usar
AI_MODEL=gpt-4o-mini
