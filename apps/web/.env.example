# RENACE — variables de entorno (web)
# Copia este archivo a .env.local y rellena los valores.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo en servidor — NUNCA en NEXT_PUBLIC
SUPABASE_SERVICE_ROLE_KEY=

# Vercel AI Gateway (proveedor del LLM para Aria)
AI_GATEWAY_API_KEY=
# Modelo a usar a través del Gateway (formato proveedor/modelo)
AI_MODEL=openai/gpt-4o-mini

# Modo demo para inversores (botón "Entrar como demo" en /login)
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_DEMO_EMAIL=demo@renace.app
NEXT_PUBLIC_DEMO_PASSWORD=DemoRenace2026!
